# Godot 4+ specific ignores
.godot/
/android/

# GUT (test framework): per-developer editor panel settings.
# Its run output goes to user://, outside the repository.
.gut_editor_config.json
.gut_editor_shortcuts.cfg

# Agent/tooling logs
.agent/

# Build outputs
/build/

# OS / editors
.DS_Store
*.swp
.vscode/
.idea/

# ATD local caches
docs/.atd_audit.db

# Native tick (docs/dev/native.md): built libraries and SCons state.
# native/godot-cpp is a submodule; its own .gitignore covers its gen/ and bin/.
/native/bin/
/native/slime_native/**/*.os
/native/slime_native/**/*.o
/native/slime_native/.sconsign*.dblite
/native/slime_native/compile_commands.json

# SlimePlatform Android plugin (native/android_plugin/, tools/android/): Gradle
# state and outputs, and the AARs build_plugin.sh copies into the addon.
/native/android_plugin/.gradle/
/native/android_plugin/.kotlin/
/native/android_plugin/build/
/native/android_plugin/plugin/build/
/native/android_plugin/local.properties
/addons/slime_platform/bin/

# Claude Code: local settings and agent worktrees (project skills in .claude/skills/ are tracked)
.claude/settings.local.json
.claude/worktrees/
