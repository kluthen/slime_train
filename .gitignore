# Godot 4+ specific ignores
.godot/
/android/

# GUT (test framework): per-developer editor panel settings.
# Its run output goes to user://, outside the repository.
.gut_editor_config.json
.gut_editor_shortcuts.cfg

# Agent/tooling logs
.agent/

# Build outputs
/build/

# OS / editors
.DS_Store
*.swp
.vscode/
.idea/

# ATD local caches
docs/.atd_audit.db

# Native tick (docs/dev/native.md): built libraries and SCons state.
# native/godot-cpp is a submodule; its own .gitignore covers its gen/ and bin/.
/native/bin/
/native/slime_native/**/*.os
/native/slime_native/**/*.o
/native/slime_native/.sconsign*.dblite
/native/slime_native/compile_commands.json
