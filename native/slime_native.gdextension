; The slime_native GDExtension: the native simulation tick (D96).
; Build the libraries with tools/build_native.sh; see docs/dev/native.md.

[configuration]

entry_symbol = "slime_native_library_init"
compatibility_minimum = "4.7"

[libraries]

linux.debug.x86_64 = "res://native/bin/libslime_native.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://native/bin/libslime_native.linux.template_release.x86_64.so"
linux.x86_64 = "res://native/bin/libslime_native.linux.template_debug.x86_64.so"
android.debug.arm64 = "res://native/bin/libslime_native.android.template_debug.arm64.so"
android.release.arm64 = "res://native/bin/libslime_native.android.template_release.arm64.so"
