extends GutTest
## Level {{LEVEL_ID}}'s own test, written once by the new-level scaffolder
## (tools/new_level.gd) and yours from then on: extend it as the level grows.
##
## What it checks now:
## - the level loads by its ID with no load errors;
## - the level-rules checker (tools/level_check/) finds no FAIL, behaviour
##   runs included (the report is printed either way);
## - the game in test mode plays it for 2 simulated minutes with no input
##   and loses no slime (none lost as stalled, none lost off screen), and the
##   base-slime count stays the same;
## - section 1 plays to its basket full: the level report's progress
##   estimate (LevelProgress) says it can, then scripted calls wake the
##   sleepers it counts on, each tapped when a train slime is at the loop
##   point its called hop takes off from (a sleeper no hop reaches wakes
##   with the ones it touches), and a tap on the switch sends the train into
##   the basket until the quota is met (a few simulated minutes); then the
##   basket plays its reward, fires and lets its slimes go until it is
##   empty, and level rule 23 holds over the whole play (ClusterWatch: the
##   largest awake cluster never above 20 slimes for more than 5 s in a
##   row; its numbers printed);
## - every fixture in levels/{{LEVEL_ID}}/fixtures/ loads through test mode,
##   and none is older than the level (a fixture saved before the level
##   changed loads without what it gained since: rerun the fixture maker).
##
## Run it:  tools/test.sh -gdisable_colors -gselect=test_level_{{LEVEL_ID}}
##
## Ideas for more tests, as tests/e2e/ does for the test level: a later
## section played the same way from its gate fixture (gate<N>-open), a
## fixture per tricky spot (tools/make_fixture.gd) and what must happen from
## it.

# @test-link [[req_level_design_rules]]
# @test-link [[req_test_level_and_test_mode]]

const LEVEL_ID := "{{LEVEL_ID}}"
const MAIN_SCENE := "res://src/main.tscn"
## The fixture maker's generic fixtures: stale() says whether a fixture is
## older than the level.
const LEVEL_FIXTURES := preload("res://tools/make_fixture/level_fixtures.gd")
const SEED := 1
## How long the no-input run plays: 2 simulated minutes.
const NO_INPUT_TICKS := 2 * 60 * Simulation.TICK_RATE
## Section 1's play: the longest wait for a train slime at a call's
## take-off point (about a lap of the loop), how long a call has to wake
## its sleeper, how many passes over section 1's sleepers, how close to the
## take-off point a train slime must be (px), and how long the basket has
## to fill once the switch is flipped.
const LAP_TICKS := 150 * Simulation.TICK_RATE
const CALL_TICKS := 15 * Simulation.TICK_RATE
const WAKE_TRIES := 3
const NEAR := 40.0
const FILL_TICKS := 180 * Simulation.TICK_RATE
## How long the full basket has to play its reward, fire and let every
## slime go (one every 0.3 s when its outlet is clear).
const DRAIN_TICKS := 120 * Simulation.TICK_RATE

## Level rule 23's measure over section 1's play (_run_until feeds it).
var _clusters: ClusterWatch = null


func test_the_level_loads_with_no_errors() -> void:
	assert_eq(LevelCatalog.problem(LEVEL_ID), "", "the level is found by its ID")
	var level := _level()
	assert_eq(level.level_id, LEVEL_ID)
	assert_gt(level.level_version, 0)
	assert_eq(level.load_errors, PackedStringArray())


func test_the_rules_checker_finds_no_fail() -> void:
	var checker := LevelChecker.new(_level())
	var results := [checker.check_load()]
	results.append_array(checker.check_all())
	var report := LevelChecker.format(results)
	gut.p(report)
	var failed := results.filter(func(result): return result["status"] == LevelChecker.FAIL)
	assert_eq(failed.size(), 0, "the checker's FAILs:\n" + LevelChecker.format(failed))


func test_two_minutes_with_no_input_lose_no_slime() -> void:
	var game := _boot({})
	var sim: Simulation = game.simulation
	var base_slimes := _base_slimes(sim)
	if game.test_mode == null:
		return
	game.test_mode.run_ticks(NO_INPUT_TICKS)
	assert_eq(sim.tick, NO_INPUT_TICKS)
	assert_eq(sim.train.stalled, [] as Array[Dictionary], "no train slime stalled")
	assert_eq(sim.stuck_slimes.stuck, [] as Array[Dictionary], "no slimes stuck in each other")
	assert_eq(sim.offscreen.lost, [] as Array[Dictionary], "no slime lost off screen")
	assert_eq(_base_slimes(sim), base_slimes, "every base slime is still there")


# @test-link [[rule_gate_opens_via_switch_basket_set]]
func test_section_1_plays_to_its_basket_full() -> void:
	_clusters = ClusterWatch.new()
	var game := _boot({})
	var sim: Simulation = game.simulation
	if game.test_mode == null:
		return
	var checker := LevelChecker.new(game.level)
	var plan: Dictionary = LevelProgress.estimate(checker)[0]
	gut.p("section 1 (estimate): %s" % [plan])
	assert_true(plan["progresses"], "the level report's progress estimate: section 1 can fill its basket")
	var asleep: Array = plan["woken"].filter(func(id): return LevelChecker.section_of(id) == 1)
	for attempt in WAKE_TRIES:
		for id in asleep.duplicate():
			# A sleeper touching a woken one wakes with it (LevelProgress.chain):
			# no call of its own when no hop reaches it.
			if not _asleep(sim, _slime(sim, id)):
				asleep.erase(id)
			elif LevelProgress.smallest_size(checker, 1, checker.data.sleepers[id]["position"]) > 0 \
					and _wake(game, checker, id):
				asleep.erase(id)
	assert_eq(asleep, [], "every sleeper the estimate counts on is woken by a call from the loop")
	if not asleep.is_empty():
		return
	var basket: String = plan["basket"]
	var switch := LevelStates.switch_of(sim.level, basket)
	_tap_centre(game, sim.level.switches[switch]["box"])
	assert_true(sim.object_states[switch]["flipped"], "the tap on %s flips it" % switch)
	var full := _run_until(game, func(): return sim.object_states[basket]["phase"] != FrontierSets.FILLING,
			FILL_TICKS, sim.level.baskets[basket]["box"].get_center())
	gut.p("%s: phase %s, weight %d after %d ticks" % [basket, sim.object_states[basket]["phase"],
			sim.object_states[basket]["weight"], full])
	assert_gt(full, 0, "%s fills to its quota (%d) within %d s" % [basket, plan["quota"], FILL_TICKS / 60])
	assert_eq(sim.train.stalled, [] as Array[Dictionary], "no train slime stalled")
	var drained := _run_until(game, func(): return sim.object_states[basket]["phase"] == FrontierSets.FIRED \
			and sim.object_states[basket]["weight"] == 0, DRAIN_TICKS, sim.level.baskets[basket]["box"].get_center())
	assert_gt(drained, -1, "%s fires and lets every slime go within %d s" % [basket, DRAIN_TICKS / 60])
	# Level rule 23 over the play, the fire-and-drain included.
	gut.p("rule 23 over section 1's play: %s" % _clusters.report())
	assert_true(_clusters.passes(), "rule 23: %s" % _clusters.report())
	_clusters = null


func test_every_fixture_loads() -> void:
	var names := _fixture_names()
	assert_has(names, "fresh", "the level as new")
	for fixture in names:
		var game := _boot({"fixture": fixture})
		assert_eq(game.level.level_id, LEVEL_ID, fixture)
		if game.test_mode != null:
			game.test_mode.run_ticks(60)


func test_no_fixture_is_older_than_the_level() -> void:
	var level := _level()
	for fixture in _fixture_names():
		var loaded := TestMode.load_fixture(fixture, LEVEL_ID)
		assert_true(loaded["ok"], "%s: %s" % [fixture, loaded["error"]])
		if not loaded["ok"] or loaded["save"].is_empty():
			continue
		var stale := LEVEL_FIXTURES.stale(loaded["save"], level.data)
		assert_eq(stale, PackedStringArray(), "fixture %s is older than the level: rerun tools/level.sh fixture "
				% fixture + "--level=%s %s (%s)" % [LEVEL_ID, fixture, "; ".join(stale)])


# --- Helpers ----------------------------------------------------------------------

## Tries to wake sleeper `stable_id` as a player would: waits (the camera
## on the spot) until a train slime big enough is at the loop point a
## called hop takes off from (LevelProgress.take_off), then taps the
## sleeper, which calls. Returns whether it woke. A sleeper deeper in a
## hollow may only wake once the one nearer the edge has gone, so the test
## tries every sleeper once per pass.
func _wake(game: Node, checker: LevelChecker, stable_id: String) -> bool:
	var sim: Simulation = game.simulation
	var sleeper := _slime(sim, stable_id)
	var at := sim.slimes.centre_of(sleeper)
	var size := LevelProgress.smallest_size(checker, 1, at)
	var from: Vector2 = LevelProgress.take_off(checker, 1, at, size)["from"]
	if _run_until(game, func(): return _train_slime_near(sim, from, size), LAP_TICKS, from) < 0:
		return false
	var screen := sim.view.world_to_screen(at)
	sim.push_input(Simulation.touch_down(0, screen))
	sim.push_input(Simulation.touch_up(0, screen))
	return _run_until(game, func(): return not _asleep(sim, sleeper), CALL_TICKS,
			from) >= 0


## Runs a tick at a time, the camera on `aim`, until `done` holds or
## `limit` ticks pass, rule 23's watch (_clusters) fed each tick. Returns
## the ticks run, or -1.
func _run_until(game: Node, done: Callable, limit: int, aim: Vector2) -> int:
	for i in limit:
		if done.call():
			return i
		game.simulation.camera.place(aim, 1.0)
		game.sync_view()
		game.test_mode.run_ticks(1)
		if _clusters != null:
			_clusters.watch(game.simulation)
	return limit if done.call() else -1


## Whether a train slime of at least `size` has its centre within NEAR px
## of `point`.
static func _train_slime_near(sim: Simulation, point: Vector2, size: int) -> bool:
	for slime_id in sim.slimes.ids():
		if sim.slimes.state_of(slime_id) == SlimeBodies.TRAIN and sim.slimes.size_of(slime_id) >= size \
				and sim.slimes.centre_of(slime_id).distance_to(point) <= NEAR:
			return true
	return false


## Taps the centre of `box` (level pixels), the camera first aimed at it.
func _tap_centre(game: Node, box: Rect2) -> void:
	var sim: Simulation = game.simulation
	sim.camera.place(box.get_center(), 1.0)
	game.sync_view()
	var at := sim.view.world_to_screen(box.get_center())
	sim.push_input(Simulation.touch_down(0, at))
	sim.push_input(Simulation.touch_up(0, at))
	game.test_mode.run_ticks(1)


## The runtime id of the slime whose stable ID is `stable_id`, or -1.
static func _slime(sim: Simulation, stable_id: String) -> int:
	for slime_id in sim.slimes.ids():
		if stable_id in sim.identities.members_of(slime_id):
			return slime_id
	return -1


## Whether `slime_id` is still a slime and asleep (a woken sleeper may have
## fused since, its id gone).
static func _asleep(sim: Simulation, slime_id: int) -> bool:
	return sim.slimes.has(slime_id) and sim.slimes.state_of(slime_id) == SlimeBodies.SLEEPER


## The level's scene, added to the test (it builds and bakes its terrain).
func _level() -> Level:
	var level: Level = load(LevelCatalog.scene_path(LEVEL_ID)).instantiate()
	add_child_autofree(level)
	return level


## The game (the main scene) in test mode on the level, time held (only
## run_ticks() moves it), with `config` over the defaults.
func _boot(config: Dictionary) -> Node:
	var game: Node = load(MAIN_SCENE).instantiate()
	add_child_autofree(game)
	var run := {"seed": SEED, "time_scale": 0, "level": LEVEL_ID}
	run.merge(config, true)
	assert_eq(game.enable_test_mode(run), PackedStringArray(), "test mode: %s" % [run])
	return game


## The base slimes in `sim`: every slime's size added up.
static func _base_slimes(sim: Simulation) -> int:
	var count := 0
	for slime_id in sim.slimes.ids():
		count += sim.slimes.size_of(slime_id)
	return count


## The level's fixtures, by name (their sidecars, <name>.fixture.json).
static func _fixture_names() -> PackedStringArray:
	var names := PackedStringArray()
	for file in DirAccess.get_files_at(LevelCatalog.fixtures_dir(LEVEL_ID)):
		if file.ends_with(TestMode.SIDECAR_EXTENSION):
			names.append(file.trim_suffix(TestMode.SIDECAR_EXTENSION))
	names.sort()
	return names
